# Copy to .env.dev / .env.staging / .env.uat (gitignored). See README.md and docs/create-api.md.

ENV=staging

# Admin — B2B/B2X UI setup + default GraphQL API
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: skip admin login when set (local only)
# ADMIN_JWT=

# Sales App (phone login)
SALES_APP_EG_PHONE=
SALES_APP_EG_PASSWORD=
SALES_APP_EG_COUNTRY_CODE=20

SALES_APP_SA_PHONE=
SALES_APP_SA_PASSWORD=

SALES_APP_JORDAN_PHONE=
SALES_APP_JORDAN_PASSWORD=

SALES_APP_VIENNA_PHONE=
SALES_APP_VIENNA_PASSWORD=

# Collector App (phone login — loginGap, no country_code in mutation)
COLLECTOR_APP_PHONE=
COLLECTOR_APP_PASSWORD=
COLLECTOR_APP_COUNTRY_CODE=20

# B2C Customer App
CUSTOMER_APP_PHONE=
CUSTOMER_APP_PASSWORD=

# REST create-trips (header: sibling-server-api-key). Required for collector-trip / collector projects.
TRIPS_API_URL=
SIBLING_SERVER_API_KEY=
# collectors.id for create-trips + updateCollector (default 916). Use myCollector { id } for your login, not JWT user id.
TRIPS_COLLECTOR_ID=

# Warehouse API (optional overrides)
WAREHOUSE_TRIP_ID=34312
WAREHOUSE_CHANNEL_TYPE=B2X

# Optional API test defaults
SALES_CONTRACTED_BRANCH_ID=
BUSINESS_CLIENT_ID=
COLLECTABLE_ID=
